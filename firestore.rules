rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isSignedIn() 
        && request.auth.token.email == "saiprasadwagh57@gmail.com"
        && isEmailVerified();
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 2. Validation Blueprints
    function isValidUserStats(data) {
      return data.keys().hasAll(['lastSeen', 'visitCount'])
        && data.keys().size() <= 4
        && data.lastSeen is timestamp
        && data.visitCount is number
        && (!('email' in data) || data.email is string)
        && (!('displayName' in data) || data.displayName is string);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['shlokaReference', 'rating', 'timestamp', 'userId', 'query', 'comment'])
        && data.keys().size() == 6
        && data.shlokaReference is string && data.shlokaReference.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.timestamp is timestamp
        && data.userId is string && data.userId.size() <= 128
        && data.query is string && data.query.size() <= 500
        && data.comment is string && data.comment.size() <= 1000;
    }

    // Collection: feedback
    match /feedback/{feedbackId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isValidFeedback(incoming())
                    && incoming().timestamp == request.time
                    && (request.auth == null || incoming().userId == request.auth.uid);
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUserStats(incoming());
    }
  }
}
